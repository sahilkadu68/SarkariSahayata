# ============================================================
# SarkariSahayata Environment Configuration
# Copy this file to .env and adjust values for your environment
# ============================================================

# Flask Application Secret Key
SECRET_KEY=change-this-to-a-secure-random-secret-key

# MySQL Database Configuration
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=your_mysql_password
MYSQL_DB=sarkarisahayata

# Flask Mail (SMTP) Configuration (e.g. Gmail App Password)
MAIL_SERVER=smtp.gmail.com
MAIL_PORT=587
MAIL_USE_TLS=true
MAIL_USERNAME=your_email@gmail.com
MAIL_PASSWORD=your_email_app_password
MAIL_DEFAULT_SENDER=noreply@sarkarisahayata.gov.in

# Master Administrator Credentials
MASTER_USER=sarkariadmin1
MASTER_PASSWORD=sarkari123

# Anthropic Claude Vision API (Optional - for Aadhaar/PAN AI verification)
ANTHROPIC_API_KEY=

# Flask Environment
FLASK_APP=flaskr
FLASK_DEBUG=1
